<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ServiceManager</RootNamespace>
    <AssemblyName>ServiceManager</AssemblyName>
    <ApplicationIcon>iconfinder_settings_2001888_dVt_icon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- The providers are built into the Debug\extensions folder of the UI. The service looks under
         <BaseDirectory>\extensions, so a debug run needs that folder as well, otherwise it finds no provider at all. -->
    <PostBuildEvent>if exist "$(MSBuildThisFileDirectory)..\ServiceManager.UI\bin\$(Configuration)\extensions" xcopy /y /i /e /q "$(MSBuildThisFileDirectory)..\ServiceManager.UI\bin\$(Configuration)\extensions" "$(TargetDir)extensions\"</PostBuildEvent>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ServiceManager.Base\ServiceManager.Base.csproj" />
  </ItemGroup>
</Project>