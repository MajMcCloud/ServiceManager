<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ServiceManager.Extensions.EventLogNotifier</RootNamespace>
    <AssemblyName>ServiceManager.Extensions.EventLogNotifier</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>..\..\ServiceManager.UI\bin\Debug\extensions\EventLogNotifier\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ServiceManager.ConfigBase\ServiceManager.ConfigBase.csproj" />
    <ProjectReference Include="..\..\ServiceManager.Extensions\ServiceManager.Extensions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>